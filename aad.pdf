def decode_file(encoded: str) -> bytes:
    return zlib.decompress(base64.b64decode(encoded))


def rebuild(target_dir: str) -> None:
    target_dir = os.path.abspath(target_dir)
    print(f"Rebuilding BFS Bot v2 into: {target_dir}\n")

    created_dirs: set[str] = set()
    file_count = 0

    for rel_path, encoded in FILES.items():
        full_path = os.path.join(target_dir, rel_path.replace("/", os.sep))
        parent = os.path.dirname(full_path)

        if parent and parent not in created_dirs:
            os.makedirs(parent, exist_ok=True)
            created_dirs.add(parent)

        content = decode_file(encoded)
        with open(full_path, "wb") as f:
            f.write(content)

        file_count += 1
        print(f"  [{file_count:3d}/{len(FILES)}] {rel_path}")

    print(f"\nDone - {file_count} files written to {target_dir}")
    print("\nNext steps:")
    print("  1. Create a .env file with your API keys")
    print("  2. pip install -r requirements.txt")
    print("  3. streamlit run app.py")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Rebuild the BFS Bot v2 project from embedded sources."
    )
    parser.add_argument(
        "--target",
        default=".",
        help="Directory to write the project into (default: current directory)",
    )
    args = parser.parse_args()
    rebuild(args.target)
